name: n8n-local-panel-public-ia

services:
  postgres:
    image: postgres:17-alpine
    container_name: n8n_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      TZ: ${TZ}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./postgres/init:/docker-entrypoint-initdb.d:ro
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 10

  ollama:
    image: ollama/ollama:latest
    container_name: n8n_ollama
    restart: unless-stopped
    environment:
      OLLAMA_NO_CLOUD: "1"
      OLLAMA_KEEP_ALIVE: "10m"
      TZ: ${TZ}
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - backend
      - model_egress       #le permitirá salir a Internet para descargar modelos

  ollama_init:
    image: ollama/ollama:latest
    container_name: n8n_ollama_init
    restart: "no"
    depends_on:
      - ollama
    environment:
      OLLAMA_HOST: http://ollama:11434
      OLLAMA_MODEL: ${OLLAMA_MODEL}
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        set -eu

        echo "Esperando que Ollama responda..."
        until ollama list >/dev/null 2>&1; do sleep 2; done
        echo "Descargando ${OLLAMA_MODEL}..."
        ollama pull "${OLLAMA_MODEL}"
        echo "Modelo ${OLLAMA_MODEL} listo."
    networks:
      - backend
      - model_egress       #le permitirá salir a Internet para descargar modelos

  n8n:
    image: ${N8N_IMAGE}
    container_name: n8n
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      # Base de datos interna de n8n
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: postgres
      DB_POSTGRESDB_PORT: 5432
      DB_POSTGRESDB_DATABASE: ${POSTGRES_DB}
      DB_POSTGRESDB_USER: ${POSTGRES_USER}
      DB_POSTGRESDB_PASSWORD: ${POSTGRES_PASSWORD}

      # El editor es LOCAL. n8n escucha dentro del contenedor,
      # pero Docker sólo publica 5678 en loopback del host.
      N8N_HOST: localhost
      N8N_LISTEN_ADDRESS: 0.0.0.0
      N8N_PORT: 5678
      N8N_PROTOCOL: http
      N8N_EDITOR_BASE_URL: http://127.0.0.1:5678/

      # Sólo los webhooks se anuncian con la URL pública.
      N8N_WEBHOOK_URL: https://${IA_HOST}/
      N8N_PROXY_HOPS: 2

      # Seguridad / runtime
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY}
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
      N8N_RUNNERS_ENABLED: "true"
      N8N_SECURE_COOKIE: "false"

      GENERIC_TIMEZONE: ${TZ}
      TZ: ${TZ}
    volumes:
      - n8n_data:/home/node/.n8n

    # CRÍTICO:
    # el panel sólo queda accesible desde ESTA PC.
    ports:
      - "127.0.0.1:5678:5678"

    networks:
      - app_net
      - backend

  react_app:
    build:
      context: ./react-app
    container_name: n8n_react_app
    restart: unless-stopped
    networks:
      - app_net

  ia_service:
    image: nginx:alpine
    container_name: ia_service
    restart: unless-stopped
    depends_on:
      - react_app
      - n8n
    volumes:
      - ./nginx/ia.conf:/etc/nginx/conf.d/default.conf:ro

    # Puerto opcional de diagnóstico local.
    # Tampoco se expone a tu LAN: sólo 127.0.0.1.
    ports:
      - "127.0.0.1:8089:80"

    networks:
      - edge
      - app_net

  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: n8n_cloudflared
    restart: unless-stopped
    depends_on:
      - ia_service
    environment:
      TUNNEL_TOKEN: ${CLOUDFLARE_TUNNEL_TOKEN}
    command: tunnel --no-autoupdate run
    networks:
      - edge

volumes:
  postgres_data:
  n8n_data:
  ollama_data:

networks:
  # cloudflared sólo necesita alcanzar el gateway público ia_service.
  edge:
    driver: bridge

  # React, ia_service y n8n se comunican aquí.
  app_net:
    driver: bridge

  # PostgreSQL y Ollama jamás se publican al host ni a Internet.
  backend:
    driver: bridge
    internal: true

  model_egress:
    driver: bridge

