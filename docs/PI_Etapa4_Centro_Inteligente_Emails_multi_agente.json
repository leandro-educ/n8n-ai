    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  try {\n    // Extraemos el string de la propiedad 'output'\n    const jsonString = item.json.output;\n    \n    // Lo convertimos a un objeto de JavaScript\n    const parsedData = JSON.parse(jsonString);\n    \n    // Devolvemos el objeto parseado para usarlo en el flujo\n    return {\n      json: parsedData\n    };\n  } catch (error) {\n    // Manejo de errores por si el LLM devuelve un formato inválido\n    throw new Error(\"El agente no devolvió un JSON válido: \" + error.message);\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
