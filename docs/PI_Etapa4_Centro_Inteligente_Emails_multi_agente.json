      ],
      "id": "10719587-2cf9-47d0-9c68-916b7c9e367c",
      "name": "procesar_respuesta_agente_derivador"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const binaries = item.binary ?? {};\n  const binaryEntries = Object.entries(binaries);\n  const hasAttachments = binaryEntries.length > 0;\n\n  if (hasAttachments) {\n    // Si tiene adjuntos, procesa cada uno\n    for (const [key, binary] of binaryEntries) {\n      output.push({\n        json: {\n          hasAttachments: true,\n          email: {\n            id: item.json.id,\n            threadId: item.json.threadId,\n            messageId: item.json.messageId,\n            subject: item.json.subject,\n            date: item.json.date,\n            from: item.json.from,\n            to: item.json.to,\n            text: item.json.text,\n          },\n          attachment: {\n            key,\n            fileName: binary.fileName,\n            mimeType: binary.mimeType,\n            fileExtension: binary.fileExtension,\n          },\n        },\n        binary: {\n          data: binary,\n        },\n      });\n    }\n  } else {\n    // Si no tiene adjuntos, emite el mail para no perderlo\n    output.push({\n      json: {\n        hasAttachments: false,\n        email: {\n          id: item.json.id,\n          threadId: item.json.threadId,\n          messageId: item.json.messageId,\n          subject: item.json.subject,\n          date: item.json.date,\n          from: item.json.from,\n          to: item.json.to,\n          text: item.json.text,\n        },\n        attachment: null,\n      },\n    });\n  }\n}\n\nreturn output;"
      },
