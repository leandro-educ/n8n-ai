    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // 1. Obtener el texto crudo de la respuesta de Gemini / Google AI\n  const rawText = item.json.content?.parts?.[0]?.text ?? \"\";\n\n  let extractedData = {};\n\n  try {\n    // 2. Limpiar posibles bloques de formato markdown ```json ... ``` o ``` ... ```\n    let cleanedText = rawText.trim();\n    if (cleanedText.startsWith(\"```json\")) {\n      cleanedText = cleanedText.replace(/^```json\\s*/, \"\").replace(/\\s*```$/, \"\");\n    } else if (cleanedText.startsWith(\"```\")) {\n      cleanedText = cleanedText.replace(/^```\\s*/, \"\").replace(/\\s*```$/, \"\");\n    }\n\n    // 3. Extraer el contenido entre las primeras llaves { ... } si viene texto adicional\n    const jsonMatch = cleanedText.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      extractedData = JSON.parse(jsonMatch[0]);\n    } else {\n      extractedData = JSON.parse(cleanedText);\n    }\n  } catch (error) {\n    // Manejo de error en caso de que el texto no sea un JSON válido\n    extractedData = {\n      error: \"No se pudo parsear el JSON de la respuesta\",\n      raw_text: rawText,\n      error_message: error.message\n    };\n  }\n\n  // 4. Devolver los datos extraídos en la raíz del json para el siguiente nodo\n  return {\n    json: extractedData,\n    binary: item.binary\n  };\n});"
      },
