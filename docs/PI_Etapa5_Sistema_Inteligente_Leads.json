    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json.data || {};\n\n  // Validaciones individuales seguras (comprobando existencia y tipo)\n  const hasName = typeof data.name === 'string' && data.name.trim().length > 0;\n  const hasDomain = typeof data.domain === 'string' && data.domain.trim().length > 0;\n  const hasEmails = Array.isArray(data.site?.emailAddresses) && data.site.emailAddresses.length > 0;\n  const hasCountry = typeof data.geo?.country === 'string' && data.geo.country.trim().length > 0;\n\n  // Verificación global\n  const completo = Boolean(hasName && hasDomain && hasEmails && hasCountry);\n\n  return {\n    json: {\n      ...item.json,\n      completo\n    },\n    binary: item.binary\n  };\n});"
      },
